      },
      {
        "name": "lstm_1",
        "type": "LSTM",
        "units": 128,
        "return_sequences": true
      },
      {
        "name": "drop_1",
        "type": "Dropout",
        "rate": 0.2
      },
      {
        "name": "lstm_2",
        "type": "LSTM",
        "units": 64,
        "return_sequences": false
      },
      {
        "name": "drop_2",
        "type": "Dropout",
        "rate": 0.2
      },
      {
        "name": "dense_hidden",
        "type": "Dense",
        "units": 32,
        "activation": "relu"
      },
      {
        "name": "output",
        "type": "Dense",
        "units": 3,
        "activation": "linear",
        "dtype": "float32"
      }
    ],
    "total_trainable_params": 128899,
    "dtype_policy": "mixed_float16",
    "optimizer": {
      "name": "Adam",
      "learning_rate": 0.0003
