   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Mapa OSM + tablas de predicciones / tramos\n",
    "print(\"\\n▼ MAPA OSM ▼\")\n",
    "display(m_osm)\n",
    "\n",
    "if not preds_osm.empty:\n",
    "    df_osm_full = preds_osm.copy()\n",
    "    df_osm_full[\"tipo\"]  = df_osm_full.index.map(tipo_elem_int).map(\n",
    "        {TIPO_ELEM_M30: \"M30\", TIPO_ELEM_URB: \"URB\"})\n",
    "    df_osm_full[\"vmed_kmh\"] = [\n",
    "        round(vmed_from_predictions(r.intensidad, r.ocupacion, r.carga,\n",
    "                                    tipo_elem_int.get(idx, 0)), 2)\n",
    "        for idx, r in df_osm_full.iterrows()\n",
    "    ]\n",
    "    print(\"\\n▼ Predicciones modo OSM (ordenadas por paso en la ruta) ▼\")\n",
    "    df_osm_full = df_osm_full.reindex([s for s in res_osm[\"sensor_ids\"]\n",
    "                                       if s in df_osm_full.index])\n",
