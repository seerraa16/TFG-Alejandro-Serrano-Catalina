{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Inferencia end-to-end — Predicción de tiempo de viaje\n",
    "\n",
    "Pipeline completo para la app Streamlit:\n",
    "\n",
    "1. **Direcciones** (texto) → geocoding → coordenadas\n",
    "2. **Routing** en los dos modos: red vial OSM y grafo de sensores\n",
    "3. **Mapa Folium** interactivo de cada modo\n",
    "4. **Lista de sensores** atravesados con distancias\n",
    "5. **Predicción LSTM** de intensidad+ocupación+carga por sensor\n",
    "6. **vmed BPR** a partir de las 3 predicciones (modificado por ocupación)\n",
    "7. **ETA**: tiempo de viaje sumando tramo a tramo\n",
    "\n",
    "**Modelo:** `outputs/lstm_best.keras` (entrada `(4, 22)`, salida `(intensidad, ocupacion, carga)`).\n",
    "\n",
    "**Lags:** lookup en los parquets `data/{train,val,test}.parquet` (rango 2021-01-01 → 2024-03-31)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §1 · Imports y configuración"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import os\n",
    "os.environ[\"CUDA_VISIBLE_DEVICES\"] = \"3\"\n",
    "\n",
    "import math\n",
    "import warnings\n",
    "from datetime import datetime, timedelta\n",
    "from pathlib import Path\n",
    "\n",
    "import folium\n",
    "import geopandas as gpd\n",
    "import joblib\n",
    "import matplotlib.pyplot as plt\n",
    "import networkx as nx\n",
    "import numpy as np\n",
    "import osmnx as ox\n",
    "import pandas as pd\n",
    "import tensorflow as tf\n",
    "from shapely.geometry import box as shapely_box\n",
    "from sklearn.neighbors import BallTree\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from IPython.display import display\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "ox.settings.log_console = False\n",
    "ox.settings.use_cache   = True\n",
    "\n",
    "# ── Rutas ────────────────────────────────────────────────────────────────\n",
    "ROOT         = Path(\"/media/uax/KINGSTON/prediccion-trafico\")\n",
    "OUTPUT_DIR   = ROOT / \"outputs\" / \"inferencia\"\n",
    "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "DATA_PATH    = ROOT / \"data\" / \"Trafico_MODELOS2.csv\"\n",
    "GRAFO_PATH   = ROOT / \"outputs\" / \"grafo_sensores.graphml\"\n",
    "MODEL_PATH   = ROOT / \"outputs\" / \"lstm_best.keras\"   # cambia a otro modelo de 3-targets si quieres\n",
    "TRAIN_PARQ   = ROOT / \"data\" / \"train.parquet\"\n",
    "VAL_PARQ     = ROOT / \"data\" / \"val.parquet\"\n",
    "TEST_PARQ    = ROOT / \"data\" / \"test.parquet\"\n",
    "\n",
    "SCALER_X_PATH = OUTPUT_DIR / \"scaler_X_inference.pkl\"\n",
    "SCALER_Y_PATH = OUTPUT_DIR / \"scaler_y_inference.pkl\"\n",
    "\n",
    "# ── Constantes del proyecto ──────────────────────────────────────────────\n",
    "TIPO_ELEM_M30 = 1   # encoding en parquet: 0=URB, 1=M30\n",
    "TIPO_ELEM_URB = 0\n",
    "\n",
    "TARGET_COLS = [\"intensidad_trafico\", \"ocupacion\", \"carga\"]\n",
    "SEQ_STEPS   = [4, 3, 2, 1]    # t-4, t-3, t-2, t-1\n",
    "SEQ_LEN     = len(SEQ_STEPS)\n",
    "\n",
    "CONTEXT_COLS = [\n",
    "    \"slot_sin\", \"slot_cos\",\n",
    "    \"dia_sem_sin\", \"dia_sem_cos\",\n",
    "    \"mes_sin\", \"mes_cos\",\n",
    "    \"es_laborable\",\n",
    "    \"lluvia_ord\", \"precip_mm\",\n",
    "    \"hay_accidente\", \"accidente_reciente_1h\", \"tiempo_accidente_norm\",\n",
    "    \"tipo_elem\",\n",
    "    \"intensidad_trafico_roll4\", \"intensidad_trafico_roll8\",\n",
    "    \"ocupacion_roll4\",          \"ocupacion_roll8\",\n",
    "    \"carga_roll4\",              \"carga_roll8\",\n",
    "]\n",
    "\n",
    "# ── Parámetros del grafo (idénticos a 1grafos.ipynb) ─────────────────────\n",
    "OSM_MARGIN = 0.015\n",
    "R_EARTH    = 6_371_000\n",
    "\n",
    "print(f\"GPU: {os.environ.get('CUDA_VISIBLE_DEVICES','?')}\")\n",
    "print(f\"OSMnx     : {ox.__version__}\")\n",
    "print(f\"NetworkX  : {nx.__version__}\")\n",
    "print(f\"TensorFlow: {tf.__version__}\")\n",
    "print(f\"Output dir: {OUTPUT_DIR}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §2 · Cargar grafo de sensores y red vial OSM\n",
    "\n",
    "Reusa el `grafo_sensores.graphml` exportado por `1grafos.ipynb` (1.069 nodos, 4.158 aristas, ya con `osm_node` por sensor) y reconstruye `G_osm` desde OSM (cacheado por OSMnx, ~3 s en runs posteriores)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── Sensor graph desde graphml (rápido) ─────────────────────────────────\n",
    "print(\"Cargando grafo de sensores...\")\n",
    "G_str = nx.read_graphml(str(GRAFO_PATH), force_multigraph=True)\n",
    "\n",
    "# graphml escribe IDs como str. Convierto a int para alinear con el parquet.\n",
    "def _to_int(x):\n",
    "    try:    return int(x)\n",
    "    except: return x\n",
    "\n",
    "mapping = {n: _to_int(n) for n in G_str.nodes}\n",
    "G = nx.relabel_nodes(G_str, mapping)\n",
    "# Cast atributos numéricos\n",
    "for n, d in G.nodes(data=True):\n",
    "    d[\"lat\"] = float(d[\"lat\"])\n",
    "    d[\"lon\"] = float(d[\"lon\"])\n",
    "    if \"osm_node\" in d:\n",
    "        d[\"osm_node\"] = int(d[\"osm_node\"])\n",
    "for u, v, d in G.edges(data=True):\n",
    "    d[\"weight\"] = float(d.get(\"weight\", 0))\n",
    "    if \"length\" in d:\n",
    "        d[\"length\"] = float(d[\"length\"])\n",
    "    if \"bearing\" in d:\n",
    "        d[\"bearing\"] = float(d[\"bearing\"])\n",
    "\n",
    "print(f\"  G: {G.number_of_nodes():,} nodos / {G.number_of_edges():,} aristas\")\n",
    "\n",
    "# ── DataFrame `sensors` reconstituido a partir del grafo ────────────────\n",
    "sensors = pd.DataFrame([\n",
    "    {\"id\":        n,\n",
    "     \"nombre\":    d.get(\"nombre\", \"\"),\n",
    "     \"latitud\":   d[\"lat\"],\n",
    "     \"longitud\":  d[\"lon\"],\n",
    "     \"tipo_elem\": d.get(\"tipo_elem\", \"URB\"),\n",
    "     \"osm_node\":  int(d.get(\"osm_node\", -1))}\n",
    "    for n, d in G.nodes(data=True)\n",
    "])\n",
    "print(f\"  sensors: {len(sensors):,} filas (cols: {list(sensors.columns)})\")\n",
    "\n",
    "# ── BallTree haversine para snap GPS → sensor ───────────────────────────\n",
    "coords_rad = np.radians(sensors[[\"latitud\", \"longitud\"]].values)\n",
    "tree = BallTree(coords_rad, metric=\"haversine\")\n",
    "\n",
    "# ── Mapa rápido sensor_id → tipo_elem (int para BPR) ────────────────────\n",
    "TIPO_STR_TO_INT = {\"M30\": TIPO_ELEM_M30, \"URB\": TIPO_ELEM_URB}\n",
    "tipo_elem_int = {row[\"id\"]: TIPO_STR_TO_INT.get(row[\"tipo_elem\"], TIPO_ELEM_URB)\n",
    "                 for _, row in sensors.iterrows()}\n",
    "print(f\"  M30: {sum(v==1 for v in tipo_elem_int.values())}  \"\n",
    "      f\"URB: {sum(v==0 for v in tipo_elem_int.values())}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── Red vial OSM (cacheada por OSMnx) ───────────────────────────────────\n",
    "north = sensors[\"latitud\"].max()  + OSM_MARGIN\n",
    "south = sensors[\"latitud\"].min()  - OSM_MARGIN\n",
    "east  = sensors[\"longitud\"].max() + OSM_MARGIN\n",
    "west  = sensors[\"longitud\"].min() - OSM_MARGIN\n",
    "\n",
    "area  = shapely_box(west, south, east, north)\n",
    "print(\"Descargando red OSM (1-2 min la primera vez, cacheado después)...\")\n",
    "G_osm = ox.graph_from_polygon(\n",
    "    area, network_type=\"drive\", retain_all=True, simplify=True,\n",
    ")\n",
    "print(f\"  G_osm: {len(G_osm.nodes):,} nodos / {len(G_osm.edges):,} aristas\")\n",
    "\n",
    "# ── Subgrafo enrutable: SCC máximo ──────────────────────────────────────\n",
    "scc = max(nx.strongly_connected_components(G_osm), key=len)\n",
    "G_osm_routable = G_osm.subgraph(scc).copy()\n",
    "print(f\"  G_osm_routable (SCC): {len(G_osm_routable.nodes):,} nodos / \"\n",
    "      f\"{len(G_osm_routable.edges):,} aristas\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §3 · Funciones de routing (sensores + OSM + por dirección)\n",
    "\n",
    "Idénticas a las de `1grafos.ipynb`, integradas aquí para que el notebook sea autosuficiente."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── Helpers comunes ──────────────────────────────────────────────────────\n",
    "\n",
    "def compass_bearing(lat1, lon1, lat2, lon2):\n",
    "    phi1, phi2 = math.radians(lat1), math.radians(lat2)\n",
    "    dlon = math.radians(lon2 - lon1)\n",
    "    x = math.sin(dlon) * math.cos(phi2)\n",
    "    y = (math.cos(phi1) * math.sin(phi2)\n",
    "         - math.sin(phi1) * math.cos(phi2) * math.cos(dlon))\n",
    "    brng = math.degrees(math.atan2(x, y))\n",
    "    return (brng + 360) % 360\n",
    "\n",
    "\n",
    "def find_nearest_sensor_candidates(lat, lon, k=10):\n",
    "    q = np.radians([[lat, lon]])\n",
    "    dist_rad, idx = tree.query(q, k=k)\n",
    "    out = []\n",
    "    for i in range(k):\n",
    "        row = sensors.iloc[int(idx[0, i])]\n",
    "        d_m = float(dist_rad[0, i]) * R_EARTH\n",
    "        out.append((row, round(d_m, 1)))\n",
    "    return out\n",
    "\n",
    "\n",
    "# ── Routing 1: grafo de sensores (Dijkstra con sensores como nodos) ─────\n",
    "\n",
    "def find_route(G, sensor_origen, sensor_destino):\n",
    "    if sensor_origen not in G.nodes:\n",
    "        raise ValueError(f\"Sensor origen {sensor_origen!r} no está en el grafo\")\n",
    "    if sensor_destino not in G.nodes:\n",
    "        raise ValueError(f\"Sensor destino {sensor_destino!r} no está en el grafo\")\n",
    "    try:\n",
    "        ruta = nx.shortest_path(G, sensor_origen, sensor_destino, weight=\"weight\")\n",
    "    except nx.NetworkXNoPath:\n",
    "        raise ValueError(f\"No hay ruta dirigida {sensor_origen!r} → {sensor_destino!r}\")\n",
    "\n",
    "    tramos, dist_total = [], 0.0\n",
    "    for orden, (u, v) in enumerate(zip(ruta[:-1], ruta[1:]), start=1):\n",
    "        edge_data = min(G[u][v].values(), key=lambda d: d.get(\"weight\", float(\"inf\")))\n",
    "        d = float(edge_data.get(\"weight\", 0.0))\n",
    "        tramos.append({\n",
    "            \"orden\": orden, \"origen\": u, \"destino\": v,\n",
    "            \"dist_m\": round(d, 1),\n",
    "            \"sentido\": edge_data.get(\"sentido\", \"?\"),\n",
    "        })\n",
    "        dist_total += d\n",
    "    return {\"ruta\": ruta, \"tramos\": tramos,\n",
    "            \"distancia_total\": round(dist_total, 1),\n",
    "            \"n_sensores\": len(ruta)}\n",
    "\n",
    "\n",
    "def route_by_coords(lat_o, lon_o, lat_d, lon_d, k_fallback=10):\n",
    "    cands_a = find_nearest_sensor_candidates(lat_o, lon_o, k=k_fallback)\n",
    "    cands_b = find_nearest_sensor_candidates(lat_d, lon_d, k=k_fallback)\n",
    "    pairs = [(ra, rb, da, db) for ra, da in cands_a for rb, db in cands_b\n",
    "             if ra[\"id\"] != rb[\"id\"]]\n",
    "    pairs.sort(key=lambda p: p[2] + p[3])\n",
    "\n",
    "    for ra, rb, da, db in pairs:\n",
    "        sa, sb = ra[\"id\"], rb[\"id\"]\n",
    "        if not nx.has_path(G, sa, sb):\n",
    "            continue\n",
    "        res = find_route(G, sa, sb)\n",
    "        res.update({\n",
    "            \"coord_origen\":   (lat_o, lon_o),\n",
    "            \"coord_destino\":  (lat_d, lon_d),\n",
    "            \"sensor_origen\":  {\"id\": sa, \"nombre\": str(ra[\"nombre\"]),\n",
    "                               \"lat\": float(ra[\"latitud\"]), \"lon\": float(ra[\"longitud\"])},\n",
    "            \"sensor_destino\": {\"id\": sb, \"nombre\": str(rb[\"nombre\"]),\n",
    "                               \"lat\": float(rb[\"latitud\"]), \"lon\": float(rb[\"longitud\"])},\n",
    "            \"snap_origen_m\":  da,\n",
    "            \"snap_destino_m\": db,\n",
    "        })\n",
    "        return res\n",
    "    print(f\"No hay ruta dirigida en los {k_fallback} sensores más cercanos.\")\n",
    "    return None\n",
    "\n",
    "\n",
    "# ── Routing 2: red vial OSM (camino real, sensores atravesados) ─────────\n",
    "\n",
    "def route_by_coords_osm(lat_o, lon_o, lat_d, lon_d):\n",
    "    osm_o = int(ox.nearest_nodes(G_osm_routable, X=lon_o, Y=lat_o))\n",
    "    osm_d = int(ox.nearest_nodes(G_osm_routable, X=lon_d, Y=lat_d))\n",
    "    if osm_o == osm_d:\n",
    "        print(\"Origen y destino se mapean al mismo nodo OSM.\"); return None\n",
    "    try:\n",
    "        ruta_osm = nx.shortest_path(G_osm_routable, osm_o, osm_d, weight=\"length\")\n",
    "    except nx.NetworkXNoPath:\n",
    "        print(f\"No hay ruta OSM entre {osm_o} y {osm_d}\"); return None\n",
    "\n",
    "    geometry, dist_total = [], 0.0\n",
    "    for u, v in zip(ruta_osm[:-1], ruta_osm[1:]):\n",
    "        ed = G_osm_routable.get_edge_data(u, v) or {}\n",
    "        if not ed:\n",
    "            continue\n",
    "        best = min(ed.values(), key=lambda d: d.get(\"length\", float(\"inf\")))\n",
    "        dist_total += float(best.get(\"length\", 0.0))\n",
    "        if best.get(\"geometry\") is not None:\n",
    "            for lon, lat in best[\"geometry\"].coords:\n",
    "                geometry.append((float(lat), float(lon)))\n",
    "        else:\n",
    "            geometry.append((float(G_osm_routable.nodes[u][\"y\"]),\n",
    "                             float(G_osm_routable.nodes[u][\"x\"])))\n",
    "            geometry.append((float(G_osm_routable.nodes[v][\"y\"]),\n",
    "                             float(G_osm_routable.nodes[v][\"x\"])))\n",
    "\n",
    "    pos_in_route = {n: i for i, n in enumerate(ruta_osm)}\n",
    "    mask = sensors[\"osm_node\"].isin(pos_in_route)\n",
    "    sens_route = sensors[mask].copy()\n",
    "    sens_route[\"pos_ruta\"] = sens_route[\"osm_node\"].map(pos_in_route)\n",
    "    sens_route = sens_route.sort_values(\"pos_ruta\").reset_index(drop=True)\n",
    "\n",
    "    return {\n",
    "        \"coord_origen\": (lat_o, lon_o), \"coord_destino\": (lat_d, lon_d),\n",
    "        \"osm_origen\": osm_o, \"osm_destino\": osm_d,\n",
    "        \"ruta_osm\": ruta_osm, \"geometry\": geometry,\n",
    "        \"distancia_total\": round(dist_total, 1),\n",
    "        \"sensores_en_ruta\": sens_route,\n",
    "        \"n_sensores\": len(sens_route), \"n_nodos_osm\": len(ruta_osm),\n",
    "    }\n",
    "\n",
    "\n",
    "# ── Geocoding + entrada unificada por dirección ─────────────────────────\n",
    "\n",
    "def geocode_place(name, default_city=\"Madrid, Spain\"):\n",
    "    n = name.lower()\n",
    "    query = name if any(s in n for s in (\"madrid\", \"spain\", \"españa\")) \\\n",
    "            else f\"{name}, {default_city}\"\n",
    "    try:\n",
    "        lat, lon = ox.geocode(query)\n",
    "    except Exception as e:\n",
    "        raise ValueError(f\"No se pudo geocodificar {name!r}: {e}\")\n",
    "    return float(lat), float(lon), query\n",
    "\n",
    "\n",
    "def _osm_cum_distances(ruta_osm):\n",
    "    cum = [0.0]\n",
    "    for u, v in zip(ruta_osm[:-1], ruta_osm[1:]):\n",
    "        ed = G_osm_routable.get_edge_data(u, v) or {}\n",
    "        if not ed:\n",
    "            cum.append(cum[-1]); continue\n",
    "        best = min(ed.values(), key=lambda d: d.get(\"length\", float(\"inf\")))\n",
    "        cum.append(cum[-1] + float(best.get(\"length\", 0.0)))\n",
    "    return cum\n",
    "\n",
    "\n",
    "def route_by_address(origen, destino, mode=\"osm\"):\n",
    "    if mode not in (\"osm\", \"sensors\"):\n",
    "        raise ValueError(f\"mode debe ser 'osm' o 'sensors'\")\n",
    "    lat_o, lon_o, q_o = geocode_place(origen)\n",
    "    lat_d, lon_d, q_d = geocode_place(destino)\n",
    "\n",
    "    if mode == \"osm\":\n",
    "        res = route_by_coords_osm(lat_o, lon_o, lat_d, lon_d)\n",
    "        if res is None: return None\n",
    "        sens = res[\"sensores_en_ruta\"]\n",
    "        cum  = _osm_cum_distances(res[\"ruta_osm\"])\n",
    "        sens_cum = [cum[int(p)] for p in sens[\"pos_ruta\"]]\n",
    "        ids   = sens[\"id\"].tolist()\n",
    "        dists = [round(sens_cum[i+1] - sens_cum[i], 1) for i in range(len(ids)-1)]\n",
    "    else:\n",
    "        res = route_by_coords(lat_o, lon_o, lat_d, lon_d)\n",
    "        if res is None: return None\n",
    "        ids   = list(res[\"ruta\"])\n",
    "        dists = [t[\"dist_m\"] for t in res[\"tramos\"]]\n",
    "\n",
    "    return {\n",
    "        \"origen\":            {\"texto\": origen,  \"query\": q_o, \"coord\": (lat_o, lon_o)},\n",
    "        \"destino\":           {\"texto\": destino, \"query\": q_d, \"coord\": (lat_d, lon_d)},\n",
    "        \"mode\":              mode,\n",
    "        \"sensor_ids\":        ids,\n",
    "        \"distancias_m\":      dists,\n",
    "        \"distancia_total_m\": float(res[\"distancia_total\"]),\n",
    "        \"raw\":               res,\n",
    "    }\n",
    "\n",
    "print(\"Funciones de routing definidas.\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §4 · Mapa Folium unificado"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def plot_route_folium(r, save=True, filename=None):\n",
    "    if r is None:\n",
    "        print(\"No hay ruta que pintar.\"); return None\n",
    "    mode = r[\"mode\"]\n",
    "    o, d = r[\"origen\"], r[\"destino\"]\n",
    "    lat_o, lon_o = o[\"coord\"]; lat_d, lon_d = d[\"coord\"]\n",
    "    dist_tot = r[\"distancia_total_m\"]; n_sens = len(r[\"sensor_ids\"])\n",
    "\n",
    "    # Centro del mapa\n",
    "    if mode == \"osm\":\n",
    "        geom = r[\"raw\"][\"geometry\"]\n",
    "        all_la = [lat_o, lat_d] + [p[0] for p in geom]\n",
    "        all_lo = [lon_o, lon_d] + [p[1] for p in geom]\n",
    "    else:\n",
    "        ruta_ids = r[\"raw\"][\"ruta\"]\n",
    "        all_la = [lat_o, lat_d] + [G.nodes[n][\"lat\"] for n in ruta_ids]\n",
    "        all_lo = [lon_o, lon_d] + [G.nodes[n][\"lon\"] for n in ruta_ids]\n",
    "    m = folium.Map(location=[(min(all_la)+max(all_la))/2, (min(all_lo)+max(all_lo))/2],\n",
    "                   zoom_start=13, tiles=\"CartoDB positron\")\n",
    "\n",
    "    if mode == \"osm\":\n",
    "        folium.PolyLine(geom, color=\"#76FF03\", weight=6, opacity=0.95,\n",
    "                        tooltip=f\"OSM: {dist_tot:,.0f} m\").add_to(m)\n",
    "        sens_route = r[\"raw\"][\"sensores_en_ruta\"]\n",
    "        for i, (_, row) in enumerate(sens_route.iterrows()):\n",
    "            d_next = (f\"{r['distancias_m'][i]:,.1f} m al siguiente\"\n",
    "                      if i < len(r[\"distancias_m\"]) else \"(último)\")\n",
    "            folium.CircleMarker(\n",
    "                [row[\"latitud\"], row[\"longitud\"]], radius=7,\n",
    "                color=\"#00ACC1\", fill=True, fill_color=\"#00E5FF\", fill_opacity=0.95,\n",
    "                tooltip=f\"#{i+1}  sensor_id: {row['id']}\",\n",
    "                popup=folium.Popup(\n",
    "                    f\"<b>sensor_id: {row['id']}</b><br>{row['nombre']}<br>\"\n",
    "                    f\"Tipo: {row['tipo_elem']}<br>Posición: #{i+1} de {n_sens}<br>\"\n",
    "                    f\"{d_next}\", max_width=240),\n",
    "            ).add_to(m)\n",
    "    else:\n",
    "        so = r[\"raw\"][\"sensor_origen\"]; sd = r[\"raw\"][\"sensor_destino\"]\n",
    "        snap_a = r[\"raw\"][\"snap_origen_m\"]; snap_b = r[\"raw\"][\"snap_destino_m\"]\n",
    "        ruta_set = set(r[\"raw\"][\"ruta\"])\n",
    "        for node, nd in G.nodes(data=True):\n",
    "            if node in ruta_set: continue\n",
    "            folium.CircleMarker([nd[\"lat\"], nd[\"lon\"]], radius=2, color=\"#B0BEC5\",\n",
    "                fill=True, fill_color=\"#B0BEC5\", fill_opacity=0.25, weight=0.3).add_to(m)\n",
    "        for t in r[\"raw\"][\"tramos\"]:\n",
    "            nu = G.nodes[t[\"origen\"]]; nv = G.nodes[t[\"destino\"]]\n",
    "            p1 = (nu[\"lat\"], nu[\"lon\"]); p2 = (nv[\"lat\"], nv[\"lon\"])\n",
    "            folium.PolyLine([p1, p2], color=\"#76FF03\", weight=5, opacity=0.90,\n",
    "                tooltip=f\"Tramo {t['orden']}: {t['origen']}→{t['destino']} ({t['dist_m']:.0f} m)\"\n",
    "            ).add_to(m)\n",
    "            mlat = p1[0] + 0.5*(p2[0]-p1[0]); mlon = p1[1] + 0.5*(p2[1]-p1[1])\n",
    "            brng = compass_bearing(p1[0], p1[1], p2[0], p2[1])\n",
    "            folium.Marker((mlat, mlon), icon=folium.DivIcon(\n",
    "                html=f'<div style=\"transform:rotate({brng}deg);font-size:10px;color:#76FF03;\">&#9650;</div>',\n",
    "                icon_size=(12,12), icon_anchor=(6,6))).add_to(m)\n",
    "        for i, nid in enumerate(r[\"raw\"][\"ruta\"][1:-1], start=1):\n",
    "            nd = G.nodes[nid]\n",
    "            folium.CircleMarker([nd[\"lat\"], nd[\"lon\"]], radius=6, color=\"#00ACC1\",\n",
    "                fill=True, fill_color=\"#00E5FF\", fill_opacity=0.90,\n",
    "                tooltip=f\"#{i+1}  sensor_id: {nid}\",\n",
    "                popup=folium.Popup(f\"<b>sensor_id: {nid}</b><br>{nd['nombre']}\", max_width=220)).add_to(m)\n",
    "        folium.PolyLine([(lat_o, lon_o), (so[\"lat\"], so[\"lon\"])],\n",
    "            color=\"#FFD600\", weight=2.5, opacity=0.9, dash_array=\"8\",\n",
    "            tooltip=f\"Snap origen: {snap_a:.1f} m\").add_to(m)\n",
    "        folium.PolyLine([(lat_d, lon_d), (sd[\"lat\"], sd[\"lon\"])],\n",
    "            color=\"#FF6F00\", weight=2.5, opacity=0.9, dash_array=\"8\",\n",
    "            tooltip=f\"Snap destino: {snap_b:.1f} m\").add_to(m)\n",
    "        folium.CircleMarker([so[\"lat\"], so[\"lon\"]], radius=11, color=\"#00C853\",\n",
    "            fill=True, fill_color=\"#00E676\", fill_opacity=1.0,\n",
    "            tooltip=f\"SENSOR ORIGEN {so['id']}\",\n",
    "            popup=folium.Popup(f\"<b>Sensor snap origen</b><br>ID: {so['id']}<br>{so['nombre']}<br>Snap: {snap_a:.1f} m\", max_width=240)).add_to(m)\n",
    "        folium.CircleMarker([sd[\"lat\"], sd[\"lon\"]], radius=11, color=\"#D50000\",\n",
    "            fill=True, fill_color=\"#FF1744\", fill_opacity=1.0,\n",
    "            tooltip=f\"SENSOR DESTINO {sd['id']}\",\n",
    "            popup=folium.Popup(f\"<b>Sensor snap destino</b><br>ID: {sd['id']}<br>{sd['nombre']}<br>Snap: {snap_b:.1f} m\", max_width=240)).add_to(m)\n",
    "\n",
    "    for lat_pt, lon_pt, color_pt, label_pt, txt_pt, q_pt in [\n",
    "        (lat_o, lon_o, \"#FFD600\", \"ORIGEN\",  o[\"texto\"], o[\"query\"]),\n",
    "        (lat_d, lon_d, \"#FF6F00\", \"DESTINO\", d[\"texto\"], d[\"query\"]),\n",
    "    ]:\n",
    "        folium.Marker([lat_pt, lon_pt], icon=folium.DivIcon(\n",
    "            html=f'<div style=\"font-size:26px;color:{color_pt};text-shadow:0 0 4px #000;line-height:1;\">&#9733;</div>',\n",
    "            icon_size=(28,28), icon_anchor=(14,14)),\n",
    "            tooltip=f\"{label_pt}: {txt_pt}\",\n",
    "            popup=folium.Popup(f\"<b>{label_pt}</b><br>Texto: {txt_pt}<br>Query: {q_pt}<br>Lat: {lat_pt:.5f}<br>Lon: {lon_pt:.5f}\", max_width=260)).add_to(m)\n",
    "\n",
    "    legend = (f\"<div style='position:fixed;bottom:30px;left:30px;z-index:1000;\"\n",
    "              f\"background:white;padding:10px 14px;border-radius:8px;border:1px solid #ccc;\"\n",
    "              f\"font-size:13px;line-height:1.7;max-width:320px;'>\"\n",
    "              f\"<b>{'OSM real' if mode=='osm' else 'Grafo de sensores'}</b><br>\"\n",
    "              f\"<small>Distancia: {dist_tot:,.0f} m ({dist_tot/1000:.2f} km)<br>\"\n",
    "              f\"Sensores: {n_sens}</small></div>\")\n",
    "    m.get_root().html.add_child(folium.Element(legend))\n",
    "\n",
    "    if save:\n",
    "        out = OUTPUT_DIR / (filename or f\"ruta_{mode}.html\")\n",
    "        m.save(str(out))\n",
    "        print(f\"  mapa guardado: {out}\")\n",
    "    return m\n",
    "\n",
    "print(\"plot_route_folium definido.\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §5 · Cargar modelo LSTM + recomputar scalers\n",
    "\n",
    "Los scalers no se guardaron al entrenar `lstm_best.keras`, así que los recomputamos a partir del `train.parquet`. La primera vez tarda ~30 s; después se cachea en disco."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── Cargar modelo ────────────────────────────────────────────────────────\n",
    "print(f\"Cargando modelo: {MODEL_PATH.name}\")\n",
    "model = tf.keras.models.load_model(str(MODEL_PATH), compile=False)\n",
    "print(f\"  input  : {model.input_shape}  →  esperado (None, 4, 22)\")\n",
    "print(f\"  output : {model.output_shape}  →  esperado (None, 3)  [intensidad, ocupacion, carga]\")\n",
    "\n",
    "# ── Sequencias para inferencia (idéntico a build_sequences de exp1/MMM) ─\n",
    "\n",
    "def build_sequences(df_rows):\n",
    "    \"\"\"df_rows: filas con TODAS las columnas lag y context. Devuelve (n, 4, 22).\"\"\"\n",
    "    context = df_rows[CONTEXT_COLS].values.astype(\"float32\")\n",
    "    steps = []\n",
    "    for k in SEQ_STEPS:\n",
    "        traffic_k = np.column_stack([\n",
    "            df_rows[f\"intensidad_trafico_lag{k}\"].values,\n",
    "            df_rows[f\"ocupacion_lag{k}\"].values,\n",
    "            df_rows[f\"carga_lag{k}\"].values,\n",
    "        ]).astype(\"float32\")\n",
    "        steps.append(np.concatenate([traffic_k, context], axis=1))\n",
    "    return np.stack(steps, axis=1)\n",
    "\n",
    "# ── Scalers (cacheados en disco tras la primera ejecución) ───────────────\n",
    "if SCALER_X_PATH.exists() and SCALER_Y_PATH.exists():\n",
    "    scaler_X = joblib.load(SCALER_X_PATH)\n",
    "    scaler_y = joblib.load(SCALER_Y_PATH)\n",
    "    print(f\"Scalers cargados de {SCALER_X_PATH.name} / {SCALER_Y_PATH.name}\")\n",
    "else:\n",
    "    print(\"Recomputando scalers desde train.parquet (~30 s)...\")\n",
    "    train_df = pd.read_parquet(TRAIN_PARQ, engine=\"pyarrow\")\n",
    "    X_seq_train = build_sequences(train_df)              # (n, 4, 22)\n",
    "    y_train     = train_df[TARGET_COLS].values.astype(\"float32\")\n",
    "    N_FEAT      = X_seq_train.shape[2]\n",
    "    scaler_X = StandardScaler().fit(X_seq_train.reshape(-1, N_FEAT))\n",
    "    scaler_y = StandardScaler().fit(y_train)\n",
    "    joblib.dump(scaler_X, SCALER_X_PATH)\n",
    "    joblib.dump(scaler_y, SCALER_Y_PATH)\n",
    "    del train_df, X_seq_train, y_train\n",
    "    print(f\"  guardados en {SCALER_X_PATH.parent}\")\n",
    "\n",
    "print(f\"  X: {scaler_X.n_features_in_} features  |  y: {scaler_y.n_features_in_} targets\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §6 · Pipeline de inferencia LSTM\n",
    "\n",
    "Carga la unión de los 3 parquets (con multi-índice `(sensor_id, datetime)`) para hacer lookup instantáneo en cualquier fecha 2021-01-01 → 2024-03-31. La primera vez tarda ~10 s; después es prácticamente gratis."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── Tabla histórica (lookup de lags y contexto en cualquier datetime) ──\n",
    "print(\"Cargando histórico (train+val+test) para lookup...\")\n",
    "NEEDED_COLS = [\"id\", \"datetime\"] + CONTEXT_COLS + [\n",
    "    f\"intensidad_trafico_lag{k}\" for k in SEQ_STEPS\n",
    "] + [\n",
    "    f\"ocupacion_lag{k}\"          for k in SEQ_STEPS\n",
    "] + [\n",
    "    f\"carga_lag{k}\"              for k in SEQ_STEPS\n",
    "]\n",
    "\n",
    "frames = []\n",
    "for parq in (TRAIN_PARQ, VAL_PARQ, TEST_PARQ):\n",
    "    df_p = pd.read_parquet(parq, columns=NEEDED_COLS, engine=\"pyarrow\")\n",
    "    frames.append(df_p)\n",
    "history_df = pd.concat(frames, ignore_index=True)\n",
    "del frames\n",
    "\n",
    "# Indexar por (id, datetime) para lookup O(1)\n",
    "history_df = history_df.set_index([\"id\", \"datetime\"]).sort_index()\n",
    "print(f\"  history: {len(history_df):,} filas\")\n",
    "print(f\"  rango  : {history_df.index.get_level_values('datetime').min()}  →  \"\n",
    "      f\"{history_df.index.get_level_values('datetime').max()}\")\n",
    "\n",
    "# ── Predictor ─────────────────────────────────────────────────────────────\n",
    "\n",
    "class TraficoPredictor:\n",
    "    \"\"\"Wrapper para inferencia LSTM batched sobre una lista de sensores.\"\"\"\n",
    "\n",
    "    def __init__(self, model, scaler_X, scaler_y, history_df):\n",
    "        self.model = model\n",
    "        self.sX    = scaler_X\n",
    "        self.sy    = scaler_y\n",
    "        self.hist  = history_df\n",
    "\n",
    "    def _row_for(self, sensor_id, dt):\n",
    "        try:\n",
    "            return self.hist.loc[(int(sensor_id), pd.Timestamp(dt))]\n",
    "        except KeyError:\n",
    "            return None\n",
    "\n",
    "    def predict_route(self, sensor_ids, dt):\n",
    "        \"\"\"\n",
    "        Devuelve (DataFrame predicciones index=sensor_id, lista_skipped).\n",
    "        DataFrame columnas: intensidad, ocupacion, carga (en escala original).\n",
    "        \"\"\"\n",
    "        rows, valid_ids, skipped = [], [], []\n",
    "        for sid in sensor_ids:\n",
    "            r = self._row_for(sid, dt)\n",
    "            if r is None:\n",
    "                skipped.append(sid); continue\n",
    "            rows.append(r); valid_ids.append(int(sid))\n",
    "        if not rows:\n",
    "            return pd.DataFrame(columns=[\"intensidad\",\"ocupacion\",\"carga\"]), skipped\n",
    "\n",
    "        df_rows = pd.DataFrame(rows)\n",
    "        X = build_sequences(df_rows)                           # (N, 4, 22)\n",
    "        X_n = self.sX.transform(X.reshape(-1, X.shape[-1])).reshape(X.shape)\n",
    "        y_n = self.model.predict(X_n, verbose=0)\n",
    "        y   = self.sy.inverse_transform(y_n)\n",
    "        return (pd.DataFrame(y, columns=[\"intensidad\",\"ocupacion\",\"carga\"],\n",
    "                             index=valid_ids),\n",
    "                skipped)\n",
    "\n",
    "\n",
    "predictor = TraficoPredictor(model, scaler_X, scaler_y, history_df)\n",
    "print(\"TraficoPredictor listo.\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §7 · BPR (vmed) y cálculo del ETA\n",
    "\n",
    "Fórmula combinando las **3 variables predichas**:\n",
    "\n",
    "```\n",
    "ratio    = carga / 100         (saturación; fallback a intensidad/capacidad)\n",
    "v_bpr    = v_libre / (1 + α · ratio^β)    (BPR clásico)\n",
    "f_occ    = max(0.15, 1 - 0.6 · (ocupacion/100)²)    (penalización por ocupación alta)\n",
    "vmed     = max(5, v_bpr · f_occ)          (km/h, con suelo de 5 km/h)\n",
    "```\n",
    "\n",
    "Parámetros: `v_libre=100` (M30) / `50` (URB), `α=0.15`, `β=4`, `capacidad=500 veh/15 min`.\n",
    "\n",
    "Para cada **tramo** entre dos sensores consecutivos: `v_tramo = (vmed_a + vmed_b) / 2` y `t_tramo = dist / v_tramo`."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "def vmed_from_predictions(intensidad, ocupacion, carga, tipo_elem,\n",
    "                          alpha=0.15, beta=4, capacity_q=500,\n",
    "                          v_libre_m30=100, v_libre_urb=50):\n",
    "    \"\"\"\n",
    "    Devuelve velocidad media en km/h a partir de las 3 predicciones.\n",
    "\n",
    "    - intensidad : veh / 15 min\n",
    "    - ocupacion  : %  (0 - 100)\n",
    "    - carga      : %  (0 - 100, ya es saturación Q/C)\n",
    "    - tipo_elem  : 1 = M30, 0 = URB\n",
    "    \"\"\"\n",
    "    v_libre = v_libre_m30 if int(tipo_elem) == TIPO_ELEM_M30 else v_libre_urb\n",
    "\n",
    "    # Saturación Q/C: usar carga (ya % de saturación), fallback a intensidad\n",
    "    carga_norm = max(0.0, min(100.0, float(carga))) / 100.0\n",
    "    if carga_norm > 1e-3:\n",
    "        ratio = carga_norm\n",
    "    else:\n",
    "        ratio = max(0.0, float(intensidad)) / capacity_q\n",
    "\n",
    "    v_bpr = v_libre / (1.0 + alpha * ratio ** beta)\n",
    "\n",
    "    # Penalización por ocupación (>30 % ya tiene efecto notable)\n",
    "    occ = max(0.0, min(100.0, float(ocupacion))) / 100.0\n",
    "    f_occ = max(0.15, 1.0 - 0.6 * occ ** 2)\n",
    "\n",
    "    return max(5.0, v_bpr * f_occ)\n",
    "\n",
    "\n",
    "def compute_eta(sensor_ids, distancias_m, predictions_df, tipo_elem_int):\n",
    "    \"\"\"\n",
    "    Para cada tramo i (sensores i e i+1):\n",
    "        v_tramo = (vmed_a + vmed_b) / 2\n",
    "        t_tramo = dist / v_tramo\n",
    "\n",
    "    Devuelve dict con tramos detallados, tiempo total y velocidad media efectiva.\n",
    "    \"\"\"\n",
    "    if predictions_df is None or len(predictions_df) == 0:\n",
    "        return {\"error\": \"Sin predicciones\"}\n",
    "\n",
    "    # vmed por sensor (solo los que tienen predicción)\n",
    "    vmeds = {}\n",
    "    for sid in predictions_df.index:\n",
    "        row = predictions_df.loc[sid]\n",
    "        vmeds[sid] = vmed_from_predictions(\n",
    "            row[\"intensidad\"], row[\"ocupacion\"], row[\"carga\"],\n",
    "            tipo_elem_int.get(sid, TIPO_ELEM_URB),\n",
    "        )\n",
    "\n",
    "    tramos, t_total = [], 0.0\n",
    "    for i in range(len(sensor_ids) - 1):\n",
    "        sid_a, sid_b = int(sensor_ids[i]), int(sensor_ids[i+1])\n",
    "        d_m  = float(distancias_m[i])\n",
    "        v_a, v_b = vmeds.get(sid_a), vmeds.get(sid_b)\n",
    "        if v_a is None or v_b is None:\n",
    "            tramos.append({\"tramo\": i+1, \"sensor_a\": sid_a, \"sensor_b\": sid_b,\n",
    "                           \"dist_m\": d_m, \"vmed_a_kmh\": v_a, \"vmed_b_kmh\": v_b,\n",
    "                           \"v_tramo_kmh\": None, \"tiempo_s\": None,\n",
    "                           \"skip\": \"sin predicción en uno de los dos extremos\"})\n",
    "            continue\n",
    "        v_tramo = (v_a + v_b) / 2\n",
    "        t_tramo = d_m / (v_tramo / 3.6) if v_tramo > 0 else 0.0\n",
    "        tramos.append({\"tramo\": i+1, \"sensor_a\": sid_a, \"sensor_b\": sid_b,\n",
    "                       \"dist_m\": round(d_m, 1),\n",
    "                       \"vmed_a_kmh\":  round(v_a, 2),\n",
    "                       \"vmed_b_kmh\":  round(v_b, 2),\n",
    "                       \"v_tramo_kmh\": round(v_tramo, 2),\n",
    "                       \"tiempo_s\":    round(t_tramo, 1)})\n",
    "        t_total += t_tramo\n",
    "\n",
    "    dist_total = sum(distancias_m)\n",
    "    return {\n",
    "        \"tramos\":              tramos,\n",
    "        \"tiempo_total_s\":      round(t_total, 1),\n",
    "        \"tiempo_total_min\":    round(t_total / 60, 2),\n",
    "        \"distancia_total_m\":   round(dist_total, 1),\n",
    "        \"velocidad_media_efectiva_kmh\":\n",
    "            round((dist_total / t_total) * 3.6, 2) if t_total > 0 else None,\n",
    "    }\n",
    "\n",
    "\n",
    "def print_eta(eta, header=\"\"):\n",
    "    if \"error\" in eta:\n",
    "        print(f\"  {header}: {eta['error']}\"); return\n",
    "    print(f\"  {header}\")\n",
    "    print(f\"  Distancia : {eta['distancia_total_m']:>10,.0f} m  \"\n",
    "          f\"({eta['distancia_total_m']/1000:.2f} km)\")\n",
    "    print(f\"  Tiempo    : {eta['tiempo_total_s']:>10,.0f} s  \"\n",
    "          f\"({eta['tiempo_total_min']:.2f} min)\")\n",
    "    print(f\"  Vmed efec : {eta['velocidad_media_efectiva_kmh']!r} km/h\")\n",
    "    print(f\"  Tramos    : {len(eta['tramos'])}\")\n",
    "\n",
    "print(\"BPR + ETA listos.\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## §8 · Demo end-to-end\n",
    "\n",
    "Cambia `ORIGEN`, `DESTINO` y `DATETIME` y vuelve a ejecutar esta celda. Es la API que llamará Streamlit:"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# ── Inputs ───────────────────────────────────────────────────────────────\n",
    "ORIGEN   = \"Calle Valderrodrigo 31\"\n",
    "DESTINO  = \"NTT Data\"\n",
    "DATETIME = pd.Timestamp(\"2024-03-15 18:30:00\")    # rango válido: 2021-01-01 → 2024-03-31\n",
    "\n",
    "# ── 1. Routing en los dos modos ──────────────────────────────────────────\n",
    "print(\"=\" * 78)\n",
    "print(f\"  ORIGEN   : {ORIGEN!r}\")\n",
    "print(f\"  DESTINO  : {DESTINO!r}\")\n",
    "print(f\"  DATETIME : {DATETIME}\")\n",
    "print(\"=\" * 78)\n",
    "\n",
    "print(\"\\n[1/4] Calculando rutas...\")\n",
    "res_osm  = route_by_address(ORIGEN, DESTINO, mode=\"osm\")\n",
    "res_sens = route_by_address(ORIGEN, DESTINO, mode=\"sensors\")\n",
    "\n",
    "# ── 2. Mapas Folium ──────────────────────────────────────────────────────\n",
    "print(\"\\n[2/4] Generando mapas...\")\n",
    "m_osm  = plot_route_folium(res_osm,  filename=\"ruta_osm.html\")\n",
    "m_sens = plot_route_folium(res_sens, filename=\"ruta_sensors.html\")\n",
    "\n",
    "# ── 3. Predicción LSTM por modo ──────────────────────────────────────────\n",
    "print(\"\\n[3/4] Inferencia LSTM...\")\n",
    "preds_osm,  skip_osm  = predictor.predict_route(res_osm[\"sensor_ids\"],  DATETIME)\n",
    "preds_sens, skip_sens = predictor.predict_route(res_sens[\"sensor_ids\"], DATETIME)\n",
    "print(f\"  modo OSM     : {len(preds_osm)} predichos / {len(skip_osm)} skipped (sin datos en {DATETIME})\")\n",
    "print(f\"  modo SENSORS : {len(preds_sens)} predichos / {len(skip_sens)} skipped\")\n",
    "\n",
    "# ── 4. ETA ───────────────────────────────────────────────────────────────\n",
    "print(\"\\n[4/4] Cálculo de ETA...\")\n",
    "eta_osm  = compute_eta(res_osm[\"sensor_ids\"],  res_osm[\"distancias_m\"],  preds_osm,  tipo_elem_int)\n",
    "eta_sens = compute_eta(res_sens[\"sensor_ids\"], res_sens[\"distancias_m\"], preds_sens, tipo_elem_int)\n",
    "\n",
    "# ── Resumen ──────────────────────────────────────────────────────────────\n",
    "print(\"\\n\" + \"=\" * 78)\n",
    "print(\"  RESULTADO\")\n",
    "print(\"=\" * 78)\n",
    "print_eta(eta_osm,  header=\"MODO OSM (camino real por carretera)\")\n",
    "print()\n",
    "print_eta(eta_sens, header=\"MODO SENSORES (Dijkstra grafo de sensores)\")\n",
    "print(\"=\" * 78)"
   ],
   "outputs": [],
   "execution_count": null
  },
