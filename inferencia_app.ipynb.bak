    "\n",
    "if eta_osm.get(\"tramos\"):\n",
    "    print(\"\\n▼ Tramos modo OSM (distancia + velocidad + tiempo) ▼\")\n",
    "    display(pd.DataFrame(eta_osm[\"tramos\"]))"
