   "source": [
    "# Mapa OSM + tabla predicciones (modo futuro)\n",
    "print(\"\\n▼ MAPA OSM (futuro) ▼\")\n",
    "display(m_osm_f)\n",
    "\n",
    "if not preds_osm_f.empty:\n",
    "    df_f = preds_osm_f.copy()\n",
    "    df_f[\"tipo\"] = df_f.index.map(tipo_elem_int).map({TIPO_ELEM_M30:\"M30\", TIPO_ELEM_URB:\"URB\"})\n",
    "    df_f[\"vmed_kmh\"] = [\n",
    "        round(vmed_from_predictions(r.intensidad, r.ocupacion, r.carga,\n",
    "                                    tipo_elem_int.get(idx, 0)), 2)\n",
    "        for idx, r in df_f.iterrows()\n",
    "    ]\n",
    "    df_f = df_f.reindex([s for s in res_osm_f[\"sensor_ids\"] if s in df_f.index])\n",
    "    print(f\"\\n▼ Predicciones modo OSM — {DATETIME_F} ▼\")\n",
    "    display(df_f.round(2))\n",
    "\n",
    "if eta_osm_f.get(\"tramos\"):\n",
    "    print(f\"\\n▼ Tramos OSM ▼\")\n",
    "    display(pd.DataFrame(eta_osm_f[\"tramos\"]))"
   ],
